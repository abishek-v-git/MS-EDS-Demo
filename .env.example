# Copy to .env and fill in. .env is git-ignored; never commit real credentials.

# ── Django ──
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ── PostgreSQL ──
DB_NAME=ms-eds-demo
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# seconds to keep DB connections open (0 = close after each request)
DB_CONN_MAX_AGE=60

# ── Logging ──
# DEBUG / INFO / WARNING / ERROR. Files go to LOG_DIR (default: ./logs), one per day.
LOG_LEVEL=INFO
# LOG_DIR=D:\logs\ms-eds
LOG_KEEP_DAYS=14
